# === Application ===
NODE_ENV=development
PORT=5000
APP_EXTERNAL_PORT=5000

# === Database (Postgres) ===
POSTGRES_USER=siam
POSTGRES_PASSWORD=siam
POSTGRES_DB=siam
DB_EXTERNAL_PORT=5432

# Host machine (pnpm start:dev, drizzle-kit on host): use localhost
DATABASE_URL=postgresql://siam:siam@localhost:5432/siam

# === Docker ===
# development | production (Dockerfile build target)
DOCKER_BUILD_TARGET=development
