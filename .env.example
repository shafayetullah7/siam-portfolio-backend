# === Application ===
NODE_ENV=development
PORT=5000
APP_EXTERNAL_PORT=5000
# SolidStart app origin (CORS credentials for admin cookies)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_ADMIN_ACCESS_SECRET=change-me-min-32-characters-long-secret
JWT_ADMIN_REFRESH_SECRET=change-me-min-32-characters-long-refresh
ADMIN_REGISTRATION_ENABLED=true
ADMIN_OTP_RECIPIENT_EMAIL=you@example.com

# === Email (Resend) ===
# console = log OTP/reset links in API output (default). resend = send via Resend API.
MAIL_PROVIDER=console
RESEND_API_KEY=re_placeholder_replace_with_real_key
# Use onboarding@resend.dev only for Resend sandbox testing; verify your domain in production.
MAIL_FROM=SIAM Admin <onboarding@resend.dev>

# === Database (Postgres) ===
POSTGRES_USER=siam
POSTGRES_PASSWORD=siam
POSTGRES_DB=siam
# Host port (5444 avoids clashing with other stacks on default 5432)
DB_EXTERNAL_PORT=5444

# Host machine (pnpm start:dev, drizzle-kit on host): port must match DB_EXTERNAL_PORT
DATABASE_URL=postgresql://siam:siam@localhost:5444/siam

# === Docker ===
DOCKER_BUILD_TARGET=development
